<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Tree View -->
    <record model="ir.ui.view" id="appointment_tree">
        <field name="name">the.appointments.tree</field>
        <field name="model">the.appointments</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="doctor_id" />
                <field name="patient_id" />
                <field name="patient_age" />
                <field name="app_date" />
                <field name="notes" />
                <field name="state" />
            </tree>
        </field>
    </record>
    <!-- 2. Form View -->
    <record id="appointment_form" model="ir.ui.view">
        <field name="name">the.appointments.form</field>
        <field name="model">the.appointments</field>
        <field name="arch" type="xml">
            <form string="Appointment Form">
                <header>
                    <button string="confirm" name="action_confirm" 
                            type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button string="done" name="action_done" type="object" 
                            class="oe_highlight" invisible="state != 'confirm'"/>
                    <button string="cancelled" name="action_cancel" type="object" 
                            invisible="state == 'done' or state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm,done"/>
                </header>
                <sheet>
                    <h1>
                        <field name="name" readonly="1" force_save="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="app_date"/>
                        </group>
                        <group>
                            <field name="patient_id" />
                            <field name="patient_age" />
                        </group>
                    </group>
                    <group>
                        <field name="doctor_id" />
                        <field name="notes" />
                    </group>
                    <notebook>
                        <page string="Prescription">
                            <field name="prescription_ids" />
                        </page>
                        <page string="Doctor Notes">
                            <group name="name" string="string">
                                <field name="doctor_notes" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread" options="{'post_refresh': 'recipients'}"/>
                </div>
            </form>
        </field>
    </record>
    <!-- 3. Pivot View (التحليل الجدول المحوري) -->
    <record id="appointment_view_pivot" model="ir.ui.view">
        <field name="name">the.appointments.pivot</field>
        <field name="model">the.appointments</field>
        <field name="arch" type="xml">
            <pivot string="Appointments Analysis">
                <field name="doctor_id" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>
    <!-- 4. Graph View (الرسم البياني) -->
    <record id="appointment_view_graph" model="ir.ui.view">
        <field name="name">the.appointments.graph</field>
        <field name="model">the.appointments</field>
        <field name="arch" type="xml">
            <graph string="Appointments Analysis" type="bar">
                <field name="doctor_id"/>
                <field name="state"/>
            </graph>
        </field>
    </record>
    <!-- 5. Prescription Views -->
    <record id="the_prescription_view_form" model="ir.ui.view">
        <field name="name">the_prescription.view.form</field>
        <field name="model">the.prescription</field>
        <field name="arch" type="xml">
            <form string="The Prescription">
                <group>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <field name="notes" />
                    </group>
                </group>
            </form>
        </field>
    </record>
    <record id="the_prescription_view_tree" model="ir.ui.view">
        <field name="name">the_prescription.view.tree</field>
        <field name="model">the.prescription</field>
        <field name="arch" type="xml">
            <tree string="The Prescription">
                <field name="name"/>
                <field name="notes"/>
            </tree>
        </field>
    </record>
    <!-- 6. Action (مُعدَّل ليشمل Pivot و Graph) -->
    <record id="action_appointments" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">the.appointments</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Make The First Appointment..
            </p>
        </field>
    </record>
</odoo>