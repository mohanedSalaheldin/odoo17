<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="appointment_tree">
        <field name="name">the.appointments.tree</field>
        <field name="model">the.appointments</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="patient_id" />
                <field name="patient_age" />
                <field name="app_date" />
                <field name="notes" />
            </tree>
        </field>
    </record>

    <record id="appointment_form" model="ir.ui.view">
        <field name="name">the.appointments.form</field>
        <field name="model">the.appointments</field>
        <field name="arch" type="xml">
            <form string="Appointment Form">
                <sheet>
                    <h1>
                        <field name="name" readonly="1" force_save="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="app_date"/>
                        </group>

                        <group>
                            <field name="patient_id" />
                            <field name="patient_age" />
                        </group>
                    </group>
                    <group>
                        <field name="notes" />
                    </group>
                </sheet>

                
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread" options="{'post_refresh': 'recipients'}"/>
                </div>
            </form>
        </field>
    </record>



    <record id="action_appointments" model="ir.actions.act_window">
        <field name="name">appointments</field>
        <field name="res_model">the.appointments</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="xml">
            <p class="o_view_nocontent_smiling_face">
                Make The First Appointment..
            </p>
        </field>
    </record>
</odoo>