<odoo>
  <data>
    <!-- explicit list view definition -->
    <record model="ir.ui.view" id="contacts_patient_info">
      <field name="name">contacts.new.add.extension</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_partner_form"/>
      <field name="arch" type="xml">
        <xpath expr="//form//sheet" position="before">
          <header>
            <button name="%(my_hospital.action_add_appointments_wizard)d" 
            type="action" class="oe_highlight" string="Add Appointments"
            context="{'default_patient_id': active_id}"/>
          </header>
        </xpath>
        <xpath expr="//div[@name='button_box']" position="inside">
          <button name="get_appointments" type="object" class="oe_stat_button"
             icon="fa-calendar" string="Appointments" sequence="1" 
             invisible="is_patient == False">
            <field name="app_count" string="Appointments" widget="statinfo"/>
          </button>
        </xpath>
        <xpath expr="//field[@name='vat']" position="before">
          <field name="is_patient" />
        </xpath>
        <xpath expr="//field[@name='is_patient']" position="after">
          <field name="birthdate" />
          <field name="age" />
        </xpath>
      </field>
    </record>
    <record id="action_patients" model="ir.actions.act_window">
      <field name="name">Patient</field>
      <field name="res_model">res.partner</field>
      <field name="view_mode">tree,form,kanban</field>
      <field name="domain">[('is_patient', '=', True)]</field>
      <!-- FIXED SYNTAX: Proper dictionary format -->
      <field name="context">{'default_is_patient': True}</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          List of Patients
        </p>
      </field>
    </record>
  </data>
</odoo>