<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="add_appointment_view_form" model="ir.ui.view">
        <field name="name">add.appointment.view.form</field>
        <field name="model">add.appointment</field>
        <field name="arch" type="xml">
            <form string="Add Appointment">
                <group>
                    <group>
                        <field name="patient_id"/>
                        <field name="doctor_id"/>
                    </group>
                    <group>
                        <field name="app_date"/>
                        <field name="note"/>
                    </group>
                </group>
                <!-- تم إخراج الـ footer خارج الـ group الرئيسي -->
                <footer>
                    <button name="action_confirm_appointment" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <!-- تم تعديل الـ id وحذف my_hospital. منه -->
    <record id="action_add_appointments_wizard" model="ir.actions.act_window">
        <field name="name">Add Appointment</field>
        <field name="res_model">add.appointment</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="add_appointment_view_form"/>
        <field name="target">new</field>
    </record>
</odoo>