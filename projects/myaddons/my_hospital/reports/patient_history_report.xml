<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_patient_history" model="ir.actions.report">
        <field name="name">Patient Medical History</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">my_hospital.report_patient_history_template</field>
        <field name="report_file">my_hospital.report_patient_history_template</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
    </record>
    <template id="report_patient_history_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h3>Patient History:
                            <span t-field="doc.name"/>
                        </h3>
                        <p>
                            <strong>Birthdate:</strong>
                            <span t-field="doc.birthdate"/> |
                            <strong>Age:</strong>
                            <span t-field="doc.age"/>
                        </p>
                        <h4 class="mt-4">Appointments Record</h4>
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Ref</th>
                                    <th>Date</th>
                                    <th>Doctor</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.appointment_ids" t-as="app">
                                    <td>
                                        <span t-field="app.name"/>
                                    </td>
                                    <td>
                                        <span t-field="app.app_date"/>
                                    </td>
                                    <td>
                                        <span t-field="app.doctor_id.name"/>
                                    </td>
                                    <td>
                                        <span t-field="app.state"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>