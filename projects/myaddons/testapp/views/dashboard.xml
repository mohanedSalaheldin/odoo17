<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="act_testapp_list" model="ir.actions.act_window">
        <field name="name">List</field>
        <field name="res_model">testapp.testapp</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="testapp.list"/>
    </record>
    <record id="act_testapp_graph" model="ir.actions.act_window">
        <field name="name">graph</field>
        <field name="res_model">testapp.testapp</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="testapp.list"/>
    </record>
    <record id="act_testapp_pivot" model="ir.actions.act_window">
        <field name="name">pivot</field>
        <field name="res_model">testapp.testapp</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="testapp.list"/>
    </record>
    <record id="testapp_dashboard" model="ir.ui.view">
        <field name="name">My Dashboard view</field>
        <field name="model">board.board</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Dashboard Form">
                <board style="2-1">
                    <column>
                        <action string="Graph" height="150" width="450" name="%(act_testapp_graph)d"/>
                        <action string="Pivot" height="150" width="450" name="%(act_testapp_pivot)d"/>
                    </column>
                    <column>
                        <action string="List" height="150" width="450" name="%(act_testapp_list)d"/>
                    </column>
                </board>
            </form>
        </field>
    </record>
    <record id="open_dashboard_record" model="ir.actions.act_window">
        <field name="name">My Dashboard</field>
        <field name="res_model">board.board</field>
        <field name="view_mode">form</field>
        <field name="usage">menu</field>
        <field name="view_id" ref="testapp_dashboard"/>
    </record>
    <menuitem
        id="my_dashboard_menu"
        parent="testapp.menu_root"
        name="My Dashboard"
        action="open_dashboard_record"
        sequence="0"/>
</odoo>