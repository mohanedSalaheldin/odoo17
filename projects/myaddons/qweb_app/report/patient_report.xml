<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="patient_profile_report" name="Patient Profile Report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="qweb_app.main_patient_template"/>
            </t>
        </t>
    </template>
    <template id="main_patient_template">
        <t t-call="web.external_layout">
            <t t-esc="doc.name"/>
            <t t-set="x1" t-value="300"/>
            <t t-esc="x1"/>
            <t t-set="x2" t-value="'Hassan'"/>
            <t t-esc="x2"/>
        </t>
    </template>
    <record id="action_report_patient_profile_report" model="ir.actions.report">
        <field name="name">Patient Card</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">qweb_app.patient_profile_report</field>
        <field name="report_file">qweb_app.patient_profile_report</field>
        <field name="print_report_name">'patient_card'</field>
        <field name="binding_model_id" ref="mail.model_res_partner"/>
        <field name="binding_type">report</field>
    </record>
